[sub_resource type="Shader" id="Shader_c01mt"]
code = "shader_type canvas_item;

void vertex() {
	// Called for every vertex the material is visible on.
}

void fragment() {
	COLOR.rgb = vec3(0., 0., abs(sin(SCREEN_UV.y) * 2.));
}

